<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyPulse"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="560"
        x:Class="KeyPulse.MainWindow"
        x:DataType="local:MainWindow"
        Icon="avares://KeyPulse/KeyPulse.ico"
        Title="KeyPulse"
        Width="860"
        Height="560"
        MinWidth="640"
        MinHeight="460">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <Border Grid.Row="0"
                Classes="Panel"
                Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Shortcuts (Alternative Keys)"
                           Classes="Label"
                           Margin="0,0,8,4" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="Action Type"
                           Classes="Label"
                           Margin="0,0,8,4" />
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Action Name"
                           Classes="Label"
                           Margin="0,0,8,4" />

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,8,0">
                    <TextBox Grid.Column="0"
                             Name="KeyCombo"
                             PlaceholderText="Press keys here (optional)"
                             MinWidth="200"
                             MaxWidth="300"
                             HorizontalAlignment="Stretch"
                             IsReadOnly="True"
                             KeyDown="KeyCombo_KeyDown"
                             TextChanged="KeyCombo_TextChanged"
                             TabIndex="0"
                             Margin="0,0,6,0" />
                    <Button Grid.Column="1"
                            Name="AddKeyButton"
                            Content="+ Add Key"
                            Classes="Secondary"
                            Click="AddKey_Click"
                            ToolTip.Tip="Add this keyboard combination as an alternative trigger" />
                </Grid>
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Name="ActionCombo"
                          SelectedIndex="0"
                          MinWidth="200"
                          MaxWidth="300"
                          HorizontalAlignment="Stretch"
                          TabIndex="1"
                          Margin="0,0,8,0">
                    <ComboBoxItem>Open a folder</ComboBoxItem>
                    <ComboBoxItem>Launch a program</ComboBoxItem>
                    <ComboBoxItem>Open a web link</ComboBoxItem>
                    <ComboBoxItem>Type text (one key at a time)</ComboBoxItem>
                    <ComboBoxItem>Paste text (instant)</ComboBoxItem>
                    <ComboBoxItem>Cycle screen brightness</ComboBoxItem>
                </ComboBox>
                <TextBox Grid.Row="1"
                         Grid.Column="2"
                         Name="ActionNameText"
                         PlaceholderText="Optional label (e.g. 'My Work Signature', 'Dev Dashboard')"
                         MinWidth="500"
                         MaxWidth="600"
                         HorizontalAlignment="Stretch"
                         MaxHeight="32"
                         Margin="0,0,8,0" />
                <StackPanel Grid.Row="1"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Name="AddButton"
                            Content="Add"
                            Classes="Primary"
                            Click="Add_Click"
                            Margin="0,0,8,0"
                            TabIndex="7"
                            MinWidth="90" />
                    <Button Name="CancelEditButton"
                            Content="Cancel"
                            Classes="Secondary"
                            Click="CancelEdit_Click"
                            IsVisible="False"
                            TabIndex="8"
                            MinWidth="80" />
                </StackPanel>

                <!-- Chips displaying all key combinations configured for this action -->
                <WrapPanel Grid.Row="2"
                           Grid.ColumnSpan="4"
                           Name="ComboChipsPanel"
                           Margin="0,4,0,2" />

                <StackPanel Grid.Row="3"
                            Grid.ColumnSpan="4"
                            Margin="0,2,0,0">
                    <TextBlock Name="EditorModeText"
                               Classes="EditModeText"
                               IsVisible="False"
                               TextWrapping="Wrap" />
                    <TextBlock Name="ShortcutErrorText"
                               Classes="ErrorText"
                               IsVisible="False" />
                    <TextBlock Name="ShortcutWarningText"
                               Classes="WarningText"
                               IsVisible="False"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="4"
                           Grid.ColumnSpan="4"
                           Name="TargetLabel"
                           Text="Folder path"
                           Classes="Label"
                           Margin="0,8,0,4" />

                <Grid Grid.Row="5"
                      Grid.ColumnSpan="4"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBox Grid.Column="0"
                             Name="TargetText"
                             PlaceholderText="Select a folder, app, URL, or text"
                             Width="800"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="34"
                             MaxHeight="76"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TabIndex="2"
                             Margin="0,0,8,0" />
                    <CheckBox Grid.Column="1"
                              Name="ObfuscateCheck"
                              Content="Hide secret text"
                              ToolTip.Tip="Blur and encrypt the target text in the shortcut list so passwords or private snippets stay hidden from view"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              TabIndex="3" />
                    <CheckBox Grid.Column="2"
                              Name="QuickActionCheck"
                              Content="Add to Quick Action Menu"
                              ToolTip.Tip="Show this shortcut in the right-click system tray menu for one-click execution without using the keyboard"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              TabIndex="4" />
                    <Button Grid.Column="3"
                            Name="ExpandTargetBtn"
                            Content="Expand"
                            Classes="Secondary"
                            Click="ExpandTarget_Click"
                            IsVisible="False"
                            TabIndex="5"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            ToolTip.Tip="Open this text in a larger, resizable editor" />
                    <Button Grid.Column="4"
                            Name="BrowseBtn"
                            Content="Browse"
                            Classes="Secondary"
                            Click="Browse_Click"
                            TabIndex="6"
                            MinWidth="92"
                            ToolTip.Tip="Choose a file or folder" />
                </Grid>

                <StackPanel Grid.Row="6"
                            Grid.ColumnSpan="4"
                            Margin="0,4,0,0">
                    <TextBlock Name="TargetErrorText"
                               Classes="ErrorText"
                               IsVisible="False" />
                    <TextBlock Name="TargetWarningText"
                               Classes="WarningText"
                               IsVisible="False"
                               TextWrapping="Wrap" />
                    <TextBlock Name="TargetHintText"
                               Classes="Muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="0,0,0,12"
                    Spacing="8">
            <TextBlock Text="Search:"
                       Classes="Label"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,2,0" />
            <TextBox Name="SearchBox"
                     MinWidth="250"
                     MaxWidth="350"
                     Width="300"
                     PlaceholderText="Search shortcuts..."
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"
                     TabIndex="9"
                     ToolTip.Tip="Filter by shortcut keys, action, target or status">
                <TextBox.InnerRightContent>
                    <Button Name="ClearSearchBtn"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ClearSearch_Click"
                            IsVisible="False"
                            Margin="0,0,4,0"
                            Padding="6,0"
                            FontSize="12"
                            FontWeight="Bold"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Clear search filter (Esc)" />
                </TextBox.InnerRightContent>
            </TextBox>
        </StackPanel>

        <Border Grid.Row="2"
                Classes="Panel"
                Padding="0">
            <Grid RowDefinitions="Auto,*"
                  Margin="12,10,12,6">
                <!-- ISSUE_23: this table was mis-wired end to end.
                     * The Action column was a hard-coded Width="200" that no resource bound to, so
                       ShortcutActionColumnWidth was a setting nothing read.
                     * The separator between Action and Target was wired to resize the STATUS column,
                       at the opposite end of the table.
                     * ShortcutStatusColumnSplitter did not exist in the markup at all, so that wiring
                       call silently did nothing.
                     * The Actions column was Width="Auto" in both grids, and because the header and
                       the rows are two SEPARATE grids, "Auto" measured the ~50px word "Actions" in
                       one and the ~162px pair of buttons in the other. That is why the heading did
                       not sit over its buttons.
                     Every column now has one resource, one splitter between it and its neighbour, and
                     an identical definition in the header grid and the row template below. The two
                     lists MUST be kept byte-for-byte identical. -->
                <Grid Grid.Row="0"
                      Name="ShortcutHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ShortcutStatusColumnWidth}" MinWidth="110" MaxWidth="260" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{DynamicResource ShortcutKeyColumnWidth}" MinWidth="130" MaxWidth="300" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{DynamicResource ShortcutActionColumnWidth}" MinWidth="120" MaxWidth="280" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{DynamicResource ShortcutTargetColumnWidth}" MinWidth="180" MaxWidth="1600" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{DynamicResource ShortcutActionsColumnWidth}" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Classes="ShortcutGridHeaderCell"
                            Name="ShortcutStatusHeader"
                            Tag="Status"
                            Cursor="Hand"
                            PointerPressed="ShortcutHeader_Pressed"
                            ToolTip.Tip="Click to sort by status">
                        <TextBlock Name="ShortcutStatusHeaderText" Text="Status" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="1">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutStatusColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize columns"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>

                    <!-- Click a header to sort. -->
                    <Border Grid.Column="2" Classes="ShortcutGridHeaderCell"
                            Name="ShortcutKeyHeader"
                            Tag="Shortcut"
                            Cursor="Hand"
                            PointerPressed="ShortcutHeader_Pressed"
                            ToolTip.Tip="Click to sort by shortcut">
                        <TextBlock Name="ShortcutKeyHeaderText" Text="Shortcut" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="3">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutKeyColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize columns"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>

                    <Border Grid.Column="4" Classes="ShortcutGridHeaderCell"
                            Name="ShortcutActionHeader"
                            Tag="Action"
                            Cursor="Hand"
                            PointerPressed="ShortcutHeader_Pressed"
                            ToolTip.Tip="Click to sort by action">
                        <TextBlock Name="ShortcutActionHeaderText" Text="Action" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="5">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutActionColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize columns"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>

                    <Border Grid.Column="6" Classes="ShortcutGridHeaderCell"
                            Name="ShortcutTargetHeader"
                            Tag="Target"
                            Cursor="Hand"
                            PointerPressed="ShortcutHeader_Pressed"
                            ToolTip.Tip="Click to sort by target">
                        <TextBlock Name="ShortcutTargetHeaderText" Text="Target" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="7">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutTargetColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize the target column"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>

                    <Border Grid.Column="8" Classes="ShortcutGridHeaderCell">
                        <TextBlock Text="Actions" Classes="ListHeader" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Name="HotkeyListContainer">
                    <ListBox Name="HotkeyList"
                             Classes="ShortcutList"
                             SelectionChanged="HotkeyList_SelectionChanged"
                             ItemsSource="{Binding VisibleHotkeys}"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.AllowAutoHide="False"
                             ScrollViewer.ScrollChanged="HotkeyList_ScrollChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:HotkeyEntry">
                                <Border Background="{Binding RowBackground}"
                                        CornerRadius="0">
                                    <Grid>
                                        <!-- Must stay identical to ShortcutHeaderGrid above. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{DynamicResource ShortcutStatusColumnWidth}" MinWidth="110" MaxWidth="260" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{DynamicResource ShortcutKeyColumnWidth}" MinWidth="130" MaxWidth="300" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{DynamicResource ShortcutActionColumnWidth}" MinWidth="120" MaxWidth="280" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{DynamicResource ShortcutTargetColumnWidth}" MinWidth="180" MaxWidth="1600" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="{DynamicResource ShortcutActionsColumnWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Classes="ShortcutGridCell">
                                            <!-- ISSUE_6: the status is a plain, readable label that
                                                 shows the whole reason. It used to be an 85px button
                                                 clipped to "Inactive: C..." that toggled the shortcut
                                                 off when clicked - reading a status must never
                                                 change anything. Enabling is the separate On/Off
                                                 control in the Actions column. -->
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Foreground="{Binding RegistrationBrush}"
                                                       ToolTip.Tip="{Binding StatusTooltip}" />
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Border Classes="ShortcutGridSeparatorCell" />
                                            <Border Classes="ShortcutGridSeparatorLine" />
                                        </Grid>
                                        <Border Grid.Column="2" Classes="ShortcutGridCell">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <TextBlock Text="{Binding KeyCombinationsDisplay}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding KeyCombinationsTooltip}" />
                                                <TextBlock Text="{Binding QuickActionIndicator}"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding QuickActionTooltip}" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Column="3">
                                            <Border Classes="ShortcutGridSeparatorCell" />
                                            <Border Classes="ShortcutGridSeparatorLine" />
                                        </Grid>
                                        <Border Grid.Column="4" Classes="ShortcutGridCell">
                                            <TextBlock Text="{Binding ActionTitle}"
                                                       ToolTip.Tip="{Binding ActionDisplay}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Grid Grid.Column="5">
                                            <Border Classes="ShortcutGridSeparatorCell" />
                                            <Border Classes="ShortcutGridSeparatorLine" />
                                        </Grid>
                                        <Border Grid.Column="6" Classes="ShortcutGridCell">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  HorizontalAlignment="Stretch">
                                                <!-- ISSUE_2: TargetDisplay is a mask when the row is
                                                     hidden, and TargetTooltip never carries the real
                                                     value. Binding Target here, with the secret also
                                                     sitting in the tool tip, meant one second of
                                                     hovering defeated the whole feature. The blur is
                                                     stronger too, so the row reads as concealed. -->
                                                <TextBlock Grid.Column="0"
                                                       Text="{Binding TargetDisplay}"
                                                       Foreground="{Binding TargetDisplayBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding TargetTooltip}">
                                                    <TextBlock.Effect>
                                                        <BlurEffect Radius="{Binding TargetBlurRadius}" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           Text="..."
                                                           Classes="Muted"
                                                           IsVisible="{Binding HasLongTarget}"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"
                                                           ToolTip.Tip="{Binding TargetOverflowHint}" />
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Column="7">
                                            <Border Classes="ShortcutGridSeparatorCell" />
                                            <Border Classes="ShortcutGridSeparatorLine" />
                                        </Grid>
                                        <Border Grid.Column="8" Classes="ShortcutGridCell">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="6">
                                                <!-- ISSUE_6: enabling and disabling is this clearly
                                                     labelled control, nothing else on the row. -->
                                                <Button Content="{Binding ToggleLabel}"
                                                        Classes="Secondary"
                                                        Click="Enabled_Click"
                                                        Width="48"
                                                        MinWidth="48"
                                                        Height="24"
                                                        MinHeight="24"
                                                        Padding="4,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        TabIndex="0"
                                                        ToolTip.Tip="{Binding ToggleTooltip}" />
                                                <Button Content="RUN"
                                                        Classes="Secondary"
                                                        Click="Run_Click"
                                                        Width="46"
                                                        MinWidth="46"
                                                        Height="24"
                                                        MinHeight="24"
                                                        Padding="4,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        TabIndex="1"
                                                        ToolTip.Tip="Execute this action immediately" />
                                                <!-- ISSUE_15: 8.5pt text is roughly two-thirds the
                                                     size of the smallest text anywhere else here,
                                                     and REMOVE is a destructive action. -->
                                                <Button Content="REMOVE"
                                                        Classes="Danger"
                                                        Click="Remove_Click"
                                                        Width="76"
                                                        MinWidth="76"
                                                        Height="24"
                                                        MinHeight="24"
                                                        Padding="4,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        TabIndex="2"
                                                        ToolTip.Tip="Delete this shortcut" />
                                                <Button Classes="Secondary"
                                                        Click="Duplicate_Click"
                                                        Width="100"
                                                        MinWidth="100"
                                                        Height="24"
                                                        MinHeight="24"
                                                        Padding="4,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        TabIndex="2"
                                                        ToolTip.Tip="Copy this shortcut's action to a new key combination">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="3">
                                                        <TextBlock Text="&#x29C9;"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="DUPLICATE"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Edge elevation drop shadows appear dynamically when list overflows (VS Code & Windows 11 style) -->
                    <Border Name="ScrollFadeTop" Height="24" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="{DynamicResource ScrollFadeEdgeColor}"/>
                                <GradientStop Offset="1" Color="#00000000"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Name="ScrollFadeBottom" Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                <GradientStop Offset="0" Color="{DynamicResource ScrollFadeEdgeColor}"/>
                                <GradientStop Offset="1" Color="#00000000"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Interactive Floating Pill Indicator: More shortcuts below -->
                    <Button Name="ScrollMoreDownPill"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12"
                            Padding="16,6"
                            CornerRadius="20"
                            Background="#F0182235"
                            BorderBrush="#60a5fa"
                            BorderThickness="1.5"
                            Cursor="Hand"
                            IsVisible="False"
                            ZIndex="25"
                            Click="ScrollMoreDownPill_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="▼"
                                       Foreground="#60a5fa"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Name="ScrollMoreDownText"
                                       Text="More shortcuts below"
                                       Foreground="#f8fafc"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="▼"
                                       Foreground="#60a5fa"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Interactive Floating Pill Indicator: Back to top -->
                    <Button Name="ScrollMoreUpPill"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0"
                            Padding="16,6"
                            CornerRadius="20"
                            Background="#F0182235"
                            BorderBrush="#60a5fa"
                            BorderThickness="1.5"
                            Cursor="Hand"
                            IsVisible="False"
                            ZIndex="25"
                            Click="ScrollMoreUpPill_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="▲"
                                       Foreground="#60a5fa"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Back to top"
                                       Foreground="#f8fafc"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Name="ScrollFadeLeft" Width="20" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Offset="0" Color="{DynamicResource ScrollFadeEdgeColor}"/>
                                <GradientStop Offset="1" Color="#00000000"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Name="ScrollFadeRight" Width="20" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,0%">
                                <GradientStop Offset="0" Color="{DynamicResource ScrollFadeEdgeColor}"/>
                                <GradientStop Offset="1" Color="#00000000"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ISSUE_22: a first-run user used to see a blank grey rectangle. -->
                    <Border Name="EmptyStatePanel"
                            IsVisible="False"
                            IsHitTestVisible="True"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="460"
                                    Spacing="8">
                            <TextBlock Name="EmptyStateTitle"
                                       Text="No shortcuts yet"
                                       Classes="SectionTitle"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock Name="EmptyStateBody"
                                       Text="Click the shortcut box above, press the keys you want (for example Ctrl + Alt + D), pick what should happen, then press Add."
                                       Classes="Muted"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Name="EmptyStateExampleButton"
                                    Content="Add an example shortcut"
                                    Classes="Primary"
                                    HorizontalAlignment="Center"
                                    Click="AddExample_Click"
                                    Margin="0,6,0,0"
                                    ToolTip.Tip="Creates a ready-made shortcut that opens your Downloads folder" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto,*"
              Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Name="ServiceStatusText"
                       Text="KeyPulse background service running. Run as administrator to trigger shortcuts inside elevated apps."
                       ToolTip.Tip="If you wish to trigger hotkeys and type text into Administrator elevated windows, run KeyPulse as Administrator."
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0" />
            <TextBlock Grid.Column="1"
                       Name="ShortcutCountText"
                       Classes="Muted"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="10,0,10,0"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <Button Content="Screen Brightness"
                        Classes="Secondary"
                        Click="ScreenBrightness_Click"
                        TabIndex="7"
                        MinWidth="136"
                        ToolTip.Tip="Control physical screen brightness and contrast across up to 3 displays and configure shortcut cycle steps." />
                <Button Content="Desktop Organizer"
                        Classes="Secondary"
                        Click="DesktopOrganizer_Click"
                        TabIndex="8"
                        MinWidth="136"
                        ToolTip.Tip="Save, restore, and manage desktop icon arrangements across your displays." />
                <Button Content="Settings"
                        Classes="Secondary"
                        Click="Settings_Click"
                        TabIndex="9"
                        MinWidth="98" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
