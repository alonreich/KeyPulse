<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyPulse"
        mc:Ignorable="d"
        d:DesignWidth="820"
        d:DesignHeight="620"
        x:Class="KeyPulse.DesktopOrganizerWindow"
        Icon="avares://KeyPulse/KeyPulse.ico"
        Title="Desktop Organizer"
        Width="820"
        Height="620"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20">

        <!-- Header Block -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                <TextBlock Text="Desktop Organizer" Classes="SectionTitle" FontSize="22" />
                <TextBlock Text="Save, restore, and organize your desktop icon layouts across all your displays."
                           Classes="Muted"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Display Status Pill -->
            <Border Grid.Column="1"
                    Background="{DynamicResource AppPanelRaisedBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Name="MonitorStatusText"
                               Text="Detecting displays..."
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Auto-Arrange Warning Banner (visible only if Windows Auto Arrange is on) -->
        <Border Grid.Row="1"
                Name="AutoArrangeWarning"
                IsVisible="False"
                Background="{DynamicResource AppPanelRaisedBrush}"
                BorderBrush="{DynamicResource AppWarningBrush}"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Windows 'Auto arrange icons' is currently turned ON on your desktop. Windows will force all icons into columns until this is disabled (Right-click Desktop → View → uncheck 'Auto arrange icons')."
                           Foreground="{DynamicResource AppWarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="2"
                Classes="Panel"
                Margin="0,0,0,14"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- Profile Name Input for Saving -->
                <TextBox Grid.Column="0"
                         Name="NewProfileNameBox"
                         MaxLength="32"
                         TabIndex="1"
                         PlaceholderText="Enter layout name (max 32 chars, e.g. Work Dual-Screen, Gaming)..."
                         KeyDown="NewProfileNameBox_KeyDown"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center" />

                <!-- Save Button -->
                <Button Grid.Column="1"
                        Name="SaveLayoutBtn"
                        Content="Save Current Layout"
                        Classes="Primary"
                        TabIndex="2"
                        Click="SaveLayout_Click"
                        Margin="0,0,8,0"
                        MinWidth="160" />

                <!-- Undo Button -->
                <Button Grid.Column="2"
                        Name="UndoBtn"
                        Content="Undo Last Restore"
                        Classes="Secondary"
                        TabIndex="3"
                        Click="Undo_Click"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Revert icons back to the arrangement right before the last restore." />

                <!-- Refresh Button -->
                <Button Grid.Column="3"
                        Name="RefreshBtn"
                        Content="Refresh"
                        Classes="Secondary"
                        TabIndex="4"
                        Click="Refresh_Click"
                        ToolTip.Tip="Re-detect monitors and icon count from Windows Explorer." />
            </Grid>
        </Border>

        <!-- Profiles List Area -->
        <Border Grid.Row="3"
                Classes="Panel"
                Padding="8"
                Margin="0,0,0,14">
            <Grid>
                <!-- Scrollable Profiles -->
                <ScrollViewer Name="ProfilesScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ProfilesStackPanel" Spacing="8" Margin="4">
                        <!-- Populated programmatically -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel Name="EmptyStatePanel"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="20">
                    <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center" />
                    <TextBlock Text="No desktop layouts saved yet"
                               Classes="SectionTitle"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Arrange your desktop icons the way you want them, type a name above, and click 'Save Current Layout'."
                               Classes="Muted"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="420" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Automation & Behavioral Settings Panel -->
        <Border Grid.Row="4"
                Classes="Panel"
                Padding="14,12"
                Margin="0,0,0,12">
            <StackPanel Spacing="10">
                <!-- Panel Header + Restore Defaults -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Automation &amp; Restore Preferences"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Name="RestoreDefaultsBtn"
                            Content="Restore Defaults"
                            Classes="Secondary"
                            TabIndex="11"
                            Padding="10,4"
                            FontSize="12"
                            Click="RestoreDefaults_Click"
                            ToolTip.Tip="Reset these desktop automation and icon placement settings back to their original out-of-the-box defaults. Your saved layout profiles are kept safe." />
                </Grid>

                <!-- Auto-Restore Checkbox -->
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <CheckBox Name="AutoRestoreToggle"
                                  Content="Auto-restore layout on display changes"
                                  FontWeight="SemiBold"
                                  TabIndex="5"
                                  IsCheckedChanged="AutoRestoreToggle_Changed" />
                        <Border Background="{DynamicResource AppPanelRaisedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Width="24" Height="24"
                                Focusable="True"
                                AutomationProperties.Name="Help: Auto-restore layout on display changes"
                                VerticalAlignment="Center"
                                Cursor="Help"
                                ToolTip.Tip="When turned on, KeyPulse watches for monitors being plugged in, unplugged, waking from sleep, or changing resolution. Once your screens finish settling, KeyPulse automatically restores your active desktop icon layout.">
                            <TextBlock Text="?" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Muted" />
                        </Border>
                    </StackPanel>
                    <TextBlock Name="AutoRestoreHintText"
                               Text="Listens for monitor disconnects, reconnects, or sleep wake-ups and snaps icons back into place."
                               Classes="Muted"
                               FontSize="11"
                               Margin="28,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Periodic Auto-Snapshot Checkbox + Interval Stepper -->
                <StackPanel Spacing="4">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Name="AutoSnapshotToggle"
                                  Content="Auto-backup icon layout"
                                  FontWeight="SemiBold"
                                  TabIndex="6"
                                  Margin="0,0,8,0"
                                  IsCheckedChanged="AutoSnapshotToggle_Changed" />
                        <Border Background="{DynamicResource AppPanelRaisedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Width="24" Height="24"
                                Focusable="True"
                                AutomationProperties.Name="Help: Auto-backup icon layout"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Cursor="Help"
                                ToolTip.Tip="Automatically saves a backup snapshot of your desktop icon positions on your chosen day interval whenever icons have moved. KeyPulse keeps the 5 newest auto-snapshots and never deletes layouts you saved manually.">
                            <TextBlock Text="?" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Muted" />
                        </Border>

                        <StackPanel Name="AutoSnapshotIntervalPanel"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Every" VerticalAlignment="Center" FontSize="12" />
                            <Button Name="AutoSnapshotMinusBtn"
                                    Content="−"
                                    Classes="Secondary"
                                    Width="28" Height="28"
                                    Padding="0"
                                    TabIndex="7"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="AutoSnapshotMinus_Click"
                                    ToolTip.Tip="Decrease auto-backup interval by 1 day (minimum 1 day)." />
                            <TextBox Name="AutoSnapshotDaysBox"
                                     Text="3"
                                     Width="46"
                                     Height="28"
                                     MinHeight="28"
                                     Padding="4,2"
                                     MaxLength="2"
                                     TabIndex="8"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     LostFocus="AutoSnapshotDays_LostFocus"
                                     KeyDown="AutoSnapshotDays_KeyDown"
                                     ToolTip.Tip="Number of days between automatic desktop icon snapshots (1 to 30 days)." />
                            <Button Name="AutoSnapshotPlusBtn"
                                    Content="+"
                                    Classes="Secondary"
                                    Width="28" Height="28"
                                    Padding="0"
                                    TabIndex="9"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="AutoSnapshotPlus_Click"
                                    ToolTip.Tip="Increase auto-backup interval by 1 day (maximum 30 days)." />
                            <TextBlock Text="days (keeps latest 5)" VerticalAlignment="Center" FontSize="12" Classes="Muted" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <!-- New Icon Placement Behavior Combo -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Place new (unsaved) icons:"
                               Classes="Label"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AppPanelRaisedBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Width="24" Height="24"
                            Focusable="True"
                            AutomationProperties.Name="Help: Place new (unsaved) icons"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Cursor="Help"
                            ToolTip.Tip="Decides where KeyPulse places newly created desktop files or folders that did not exist when your layout was originally saved.">
                        <TextBlock Text="?" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Muted" />
                    </Border>
                    <ComboBox Name="NewIconBehaviorCombo"
                              SelectionChanged="NewIconBehaviorCombo_Changed"
                              TabIndex="10"
                              Width="290"
                              MaxWidth="310">
                        <ComboBoxItem Content="Group in center of primary screen (Default)" />
                        <ComboBoxItem Content="Leave new icons untouched in place" />
                        <ComboBoxItem Content="Align down right side of primary screen" />
                        <ComboBoxItem Content="Group in center of secondary monitor" />
                    </ComboBox>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Footer / Status Notification Bar -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Name="StatusNotificationText"
                       Text="Ready."
                       Classes="Muted"
                       FontSize="12"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Close"
                    Classes="Secondary"
                    TabIndex="12"
                    Click="Close_Click"
                    MinWidth="90" />
        </Grid>
    </Grid>
</Window>
