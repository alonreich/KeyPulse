<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyPulse"
        mc:Ignorable="d"
        d:DesignWidth="820"
        d:DesignHeight="620"
        x:Class="KeyPulse.DesktopOrganizerWindow"
        Icon="avares://KeyPulse/KeyPulse.ico"
        Title="Desktop Organizer"
        Width="820"
        Height="620"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20">

        <!-- Header Block -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Desktop Organizer" Classes="SectionTitle" FontSize="22" />
                <TextBlock Text="Save, restore, and organize your desktop icon layouts across all your displays."
                           Classes="Muted" />
            </StackPanel>

            <!-- Display Status Pill -->
            <Border Grid.Column="1"
                    Background="{DynamicResource AppPanelRaisedBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Name="MonitorStatusText"
                               Text="Detecting displays..."
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Auto-Arrange Warning Banner (visible only if Windows Auto Arrange is on) -->
        <Border Grid.Row="1"
                Name="AutoArrangeWarning"
                IsVisible="False"
                Background="#2D1F05"
                BorderBrush="{DynamicResource AppWarningBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Windows 'Auto arrange icons' is currently turned ON on your desktop. Windows will force all icons into columns until this is disabled (Right-click Desktop → View → uncheck 'Auto arrange icons')."
                           Foreground="{DynamicResource AppWarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="2"
                Classes="Panel"
                Margin="0,0,0,14"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- Profile Name Input for Saving -->
                <TextBox Grid.Column="0"
                         Name="NewProfileNameBox"
                         PlaceholderText="Enter layout name (e.g. Work Dual-Screen, Clean Desktop, Gaming)..."
                         Margin="0,0,10,0"
                         VerticalAlignment="Center" />

                <!-- Save Button -->
                <Button Grid.Column="1"
                        Name="SaveLayoutBtn"
                        Content="Save Current Layout"
                        Classes="Primary"
                        Click="SaveLayout_Click"
                        Margin="0,0,8,0"
                        MinWidth="160" />

                <!-- Undo Button -->
                <Button Grid.Column="2"
                        Name="UndoBtn"
                        Content="Undo Last Restore"
                        Classes="Secondary"
                        Click="Undo_Click"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Revert icons back to the arrangement before the last restore." />

                <!-- Refresh Button -->
                <Button Grid.Column="3"
                        Name="RefreshBtn"
                        Content="Refresh"
                        Classes="Secondary"
                        Click="Refresh_Click"
                        ToolTip.Tip="Re-detect monitors and icon count from Windows Explorer." />
            </Grid>
        </Border>

        <!-- Profiles List Area -->
        <Border Grid.Row="3"
                Classes="Panel"
                Padding="8"
                Margin="0,0,0,14">
            <Grid>
                <!-- Scrollable Profiles -->
                <ScrollViewer Name="ProfilesScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ProfilesStackPanel" Spacing="8" Margin="4">
                        <!-- Populated programmatically -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel Name="EmptyStatePanel"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="20">
                    <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center" />
                    <TextBlock Text="No desktop layouts saved yet"
                               Classes="SectionTitle"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Arrange your desktop icons the way you want them, type a name above, and click 'Save Current Layout'."
                               Classes="Muted"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="420" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Automation & Behavioral Settings Panel -->
        <Border Grid.Row="4"
                Classes="Panel"
                Padding="14"
                Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <!-- Auto-Restore Checkbox -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,16,8">
                    <CheckBox Name="AutoRestoreToggle"
                              Content="Auto-restore layout on display connection or resolution change"
                              FontWeight="SemiBold"
                              IsCheckedChanged="AutoRestoreToggle_Changed" />
                    <TextBlock Text="Listens for monitor disconnects, reconnects, or sleep wake-ups and automatically snaps icons back into place after displays settle."
                               Classes="Muted"
                               FontSize="11"
                               Margin="28,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Periodic Auto-Snapshot Checkbox -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,16,10">
                    <CheckBox Name="AutoSnapshotToggle"
                              Content="Periodically take automated layout snapshots (keeps last 5 auto-snapshots)"
                              FontWeight="SemiBold"
                              IsCheckedChanged="AutoSnapshotToggle_Changed" />
                    <TextBlock Text="Automatically saves your desktop layout every few days when icons move, keeping the 5 newest auto-snapshots. Your manually saved layouts are protected and never auto-deleted."
                               Classes="Muted"
                               FontSize="11"
                               Margin="28,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- New Icon Placement Behavior Combo -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="When restoring, place unfamiliar (new) icons:"
                               Classes="Label"
                               VerticalAlignment="Center" />
                    <ComboBox Name="NewIconBehaviorCombo"
                              SelectionChanged="NewIconBehaviorCombo_Changed"
                              MinWidth="290">
                        <ComboBoxItem Content="Group in a tidy grid in center of screen (Default)" />
                        <ComboBoxItem Content="Leave new icons untouched right where they are" />
                        <ComboBoxItem Content="Align down the side of the primary monitor" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Status Notification Bar -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Name="StatusNotificationText"
                       Text="Ready."
                       Classes="Muted"
                       FontSize="12"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Close"
                    Classes="Secondary"
                    Click="Close_Click"
                    MinWidth="90" />
        </Grid>
    </Grid>
</Window>
