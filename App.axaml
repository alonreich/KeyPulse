        </Style>

        <!-- Voiceover entry: distinct from general primary actions in the main editing controls. -->
        <Style Selector="Button.VoiceOverEntry">
            <Setter Property="BorderBrush" Value="{DynamicResource AppVoiceOverBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppVoiceOverButtonGradient}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.VoiceOverEntry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppVoiceOverButtonHoverGradient}"/>
        </Style>
        <Style Selector="Button.VoiceOverEntry:disabled">
            <Setter Property="Foreground" Value="{DynamicResource AppVoiceOverDisabledForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppVoiceOverDisabledBorderBrush}"/>
        </Style>
        <Style Selector="Button.VoiceOverEntry:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppVoiceOverDisabledBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.Primary:disabled">
