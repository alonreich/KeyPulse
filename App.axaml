            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppZoomBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
