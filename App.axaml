            <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}"/>
        </Style>
        <Style Selector="Button.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}"/>
        </Style>

        <!-- Secondary Buttons (Dynamic Resource Tokens) -->
        <Style Selector="Button.Secondary">
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        </Style>
        <Style Selector="Button.Secondary:disabled">
            <Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}"/>
        </Style>
        <Style Selector="Button.Secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}"/>
        </Style>

        <Style Selector="ToggleButton.Primary:disabled">
            <Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}"/>
        </Style>
        <Style Selector="ToggleButton.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}"/>
        </Style>

        <!-- Success Buttons (VoiceOver-style depth gradient — bright top rim into a deep base) -->
        <Style Selector="Button.Success">
            <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessDeepBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppSuccessButtonGradient}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSuccessButtonHoverGradient}"/>
        </Style>

        <Style Selector="Button.Success:disabled">
            <Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}"/>
        </Style>
        <Style Selector="Button.Success:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}"/>
        </Style>

        <!-- Danger Buttons (VoiceOver-style depth gradient — bright top rim into a deep base) -->
        <Style Selector="Button.Danger">
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerDeepBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppDangerButtonGradient}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDangerButtonHoverGradient}"/>
        </Style>

        <Style Selector="Button.Danger:disabled">
            <Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}"/>
        </Style>
        <Style Selector="Button.Danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}"/>
        </Style>

        <!-- Social media buttons.
             ISSUE_02: explicit always-white Foreground so labels stay readable on the
             saturated brand backgrounds in BOTH Light and Dark ThemeVariants
             (previously inherited near-black text in Light theme — black-on-black on TikTok). -->
        <Style Selector="Button.WhatsApp">
            <Setter Property="Background" Value="{DynamicResource AppWhatsAppBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- ISSUE_10: hover states now use dedicated brighter Hover brushes (previously the
             resting brand brush was re-applied, producing zero visible hover feedback). -->
        <Style Selector="Button.WhatsApp:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppWhatsAppHoverBrush}"/>
        </Style>
        <Style Selector="Button.Instagram">
            <Setter Property="Background" Value="{DynamicResource AppInstagramBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Instagram:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppInstagramHoverBrush}"/>
        </Style>
        <Style Selector="Button.YouTube">
            <Setter Property="Background" Value="{DynamicResource AppYouTubeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.YouTube:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppYouTubeHoverBrush}"/>
        </Style>
        <Style Selector="Button.TikTok">
            <Setter Property="Background" Value="{DynamicResource AppTikTokBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTikTokBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.TikTok:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTikTokHoverBrush}"/>
        </Style>

        <!-- Universal slider thumb — enlarged resting dot (~1.5x) that grows SLOWLY to 2x when grabbed.
             ISSUE_03: single authoritative thumb style (a second duplicate selector below was merged
             into this block; ZIndex keeps the previously-winning max value). -->
        <Style Selector="Slider /template/ Thumb">
            <!-- ⚠️ SLIDER_04 — WIDTH IS 52, NOT 44, AND THAT NUMBER IS DERIVED, NOT TASTE.
                 The knob is a 26px Ellipse that grows to scale(2.0) while held = 52px rendered.
                 `Track` centres the thumb in its reserved slot, so the dot's centre can never get
                 closer to either end than HALF the thumb's width. At 44 that is 22px, and a 52px
                 dot centred 22px in reaches 4px PAST the slider's own left edge — which is why the
                 knob appeared sliced at 0% and 100%: it was painting outside its parent and being
                 covered by whatever sat beside it.
                 52 = the largest rendered dot, so at the extremes the dot lands exactly flush with
                 the slider edge and never leaves its own bounds. If you ever change the press
                 scale or the 26px Ellipse, RECOMPUTE THIS (and the rail inset below, which must
                 stay at half this value). Height stays 44: the vertical overflow is handled by
                 margins on the hosting rows, not by the thumb. -->
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="MinHeight" Value="44" />
            <!-- THE KNOB MUST BE A DOT — and this is the ONLY reliable way to guarantee it.
                 Forcing the thumb to 44x44 above made it render as a SQUARE, because Fluent's stock
                 Thumb template does not honour CornerRadius: setting CornerRadius on the Thumb had
                 no effect at all (verified on a real run). Rather than keep guessing at the theme's
                 internals, the template is replaced outright with a single Ellipse.
                 The Ellipse has no Width/Height so it stretches to whatever size the Width/Height
                 setters above give the thumb, which keeps the 44px hit target intact, and it is
                 filled from the thumb's own Background so every hover/pressed Background override
                 below still works untouched. Avalonia's default RenderTransformOrigin is the
                 centre, so scale(1.3) on hover and scale(2.0) while held grow the dot from its
                 middle and spring back through the existing 0.3s transform transition. -->
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- The Panel keeps the FULL 44x44 hit target (Background must stay non-null or
                         it stops hit-testing), while the visible dot is a fixed 21px centred inside
                         it. Letting the Ellipse stretch made the knob 44px wide — correct as a
                         touch target, far too fat as a knob. Hit area and visible size are two
                         different things here and must stay separate.
                         RenderTransform scale on the thumb scales this child with it, so the
                         hover/press growth below still works off the 21px base. -->
                    <Panel Background="Transparent">
                        <Ellipse Width="26" Height="26"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{TemplateBinding Background}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <!-- Explicit resting fill. The template above draws the dot from the thumb's OWN
                 Background, so it must not be left to whatever Fluent happened to set: if the stock
                 theme painted its fill on an inner element rather than on Background, the dot would
                 come out invisible — worse than the square it replaces. Pinning it here also gives
                 the BrushTransition below a real value to animate FROM into the hover glow.
                 This is the resting knob colour; change this one token to restyle it. -->
            <Setter Property="Background" Value="{DynamicResource AppInfoBrush}" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="ZIndex" Value="2147483647" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Slider /template/ Track">
            <Setter Property="ZIndex" Value="9998" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <!-- ════════════════════════════════════════════════════════════════════════════════
             SLIDER_01 — THE BROKEN TRACK LINE.

             `Track` lays out DecreaseButton | Thumb | IncreaseButton and reserves the thumb's
             LAYOUT width for the middle slot. That width is 44px (the suite's grab target), while
             the visible knob is a 26px Ellipse — and RenderTransform scaling does NOT change
             layout width, so the reserved gap stays 44px at every size.

             Measured result: 44px gap around a 26px dot leaves NINE PIXELS OF BARE TRACK ON EACH
             SIDE at rest. The rail reads as two separate horizontal lines with the knob floating
             between them, which is exactly what it looks like on screen. (At scale(2.0) the dot
             grows to 52px and finally covers the gap — so the break appears to heal while
             dragging and returns on release, which makes it read as a glitch rather than a style.)

             FIX PART 1 — CLOSE THE GAP: pull each half of the rail 22px INTO the thumb's slot with
             a negative margin, so the two halves meet underneath the knob and the line is
             continuous at every size. 26 = half the 52px thumb (SLIDER_04). These two numbers MUST stay in step.

             FIX PART 2 — THE RAIL MUST ALSO END WHERE THE DOT ENDS: because Track reserves the
             thumb's 44px, the thumb CENTRE can only travel from 22px to (width - 22px). A rail
             drawn the full width therefore has 22px at each end the dot can never reach — at 100%
             you see bare rail to the RIGHT of the dot, at 0% to its LEFT. So each half ALSO gets a
             POSITIVE margin on its OUTER edge, insetting the rail to exactly [22, width-22], which
             is precisely the dot's travel range. Dot and rail now start and finish together.
                 Decrease: left  +22 (inset)   right -22 (meet under the thumb)
                 Increase: left  -22 (meet)    right +22 (inset)

             ⚠️ NAME-TARGETED, SO IT FAILS SAFE. If a future Avalonia theme renames these template
             parts the selectors simply match nothing and the rail goes back to being split — ugly,
             never broken. Do NOT "fix" this by shrinking the Thumb to 26px: that would drop the
             grab target from 44px to 26px and break the Font-Scale/hit-target rule in Section 4.
             ════════════════════════════════════════════════════════════════════════════════ -->
        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="26,0,-26,0" />
        </Style>
        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="-26,0,26,0" />
        </Style>
        <Style Selector="Slider:vertical /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,-22,0,22" />
        </Style>
        <Style Selector="Slider:vertical /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="0,22,0,-22" />
        </Style>
        <!-- Let the (growing) thumb paint outside every internal container so it is
             never cut off by the slider's own groove/track frame. Handle-only change. -->
        <Style Selector="Slider /template/ Grid">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="Slider /template/ Border">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="Slider /template/ Panel">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <!-- ================================================================================
             KNOB HOVER / PRESS — the selectors target the THUMB's own pseudo-classes, not the
             slider's. This is deliberate and fixes two real faults:

             STUTTER: `Slider:pointerover` fires for the whole 44px-tall track row. On every
             timeline the seek Canvas (TimelineMarkersCanvas et al) sits ON TOP of the slider and
             is hit-testable, so dragging the mouse across the timeline handed hover back and forth
             between the two — the knob grew and shrank repeatedly, which read as a flicker.
             `Thumb:pointerover` only fires over the knob itself, so crossing the track cannot
             retrigger it. It also matches the intended behaviour: the glow belongs to the dot.

             NO GROWTH WHILE DRAGGING: `Slider:pressed` is not raised while the THUMB is being
             dragged — the thumb captures the pointer, so the slider never enters its pressed state
             and the knob stayed small for the whole drag. `Thumb:pressed` is set by the thumb for
             exactly as long as the button is held, which is the "grows and stays large until
             released" behaviour. The slider-level selector is kept underneath as a harmless
             fallback for clicks that land on the track rather than the knob.

             ORDER MATTERS: :pressed must come after :pointerover, or the hover scale would win
             while dragging (the pointer is also over the thumb).
             ================================================================================ -->
        <Style Selector="Slider /template/ Thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
            <Setter Property="Background" Value="{DynamicResource AppFocusOuterBrush}" />
        </Style>
        <Style Selector="Slider:pressed /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(2.0)" />
        </Style>
        <Style Selector="Slider /template/ Thumb:pressed">
            <Setter Property="RenderTransform" Value="scale(2.0)" />
            <Setter Property="Background" Value="{DynamicResource AppFocusInnerBrush}" />
        </Style>

        <!-- ================================================================================
             TIMELINE KNOB — driven by CLASSES, not pseudo-classes. See Controls/TimelineKnob.cs.
             On every timeline the seek Canvas covers the Slider and takes all pointer input, so
             the Thumb never gets :pointerover or :pressed and the Slider only gets :pointerover
             intermittently (in the thin band where it peeks past the canvas — that intermittency
             WAS the flicker). TimelineKnob.Attach flips these two classes from the canvas instead,
             which is the surface the user actually touches.
             knobdrag comes last so a held drag always beats hover.
             ================================================================================ -->
        <Style Selector="Slider.knobhover /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
            <Setter Property="Background">
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="{DynamicResource AppFocusOuterColor}" />
                    <GradientStop Offset="0.5" Color="{DynamicResource AppInfoColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource AppSliderGlowEdgeColor}" />
                </RadialGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Slider.knobdrag /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(1.9)" />
            <Setter Property="Background">
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="{DynamicResource AppFocusOuterColor}" />
                    <GradientStop Offset="0.5" Color="{DynamicResource AppInfoColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource AppSliderGlowEdgeColor}" />
                </RadialGradientBrush>
            </Setter>
        </Style>
        <!-- CompactSlider (timeline scrubber + vertical volume): resting dot 21px -->
        <Style Selector="Slider.CompactSlider /template/ Thumb">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <!-- Shape comes from the Ellipse template on the base Slider thumb style above; this
                 selector only needs to agree on the size. -->
        </Style>
        <!-- CompactSlider inherits the knob shape, hover and press behaviour from the base Slider
             thumb styles above. It previously repeated them via `Slider.CompactSlider:pointerover`,
             which is the whole-track selector that caused the flicker — removed for that reason.
             Keep this selector free of RenderTransform setters: anything here would land AFTER the
             base :pressed rule and win, re-breaking grow-on-drag. -->
        <Style Selector="Slider.CompactSlider:pressed /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(2.0)" />
        </Style>

        <!-- ComboBox cursor + focus consistency -->
        <Style Selector="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusOuterBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusInnerBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- ISSUE_09 (audit round 5): this was `TextBox.error` — a manual STYLE CLASS that no XAML
             element and no line of C# in the suite ever added, so the app's only red-border
             invalid-input treatment was permanently unreachable. Switched to Avalonia's built-in
             `:error` PSEUDO-CLASS, which DataValidationErrors raises automatically whenever a bound
             TextBox's binding reports a validation error. It now fires suite-wide with zero
             code — e.g. SettingsWindow's DefaultMusicFolderTextBox, which is already wrapped in a
             DataValidationErrors host but previously had no border feedback at all. -->
        <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="DataValidationErrors">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel LastChildFill="True">
                        <ContentControl DockPanel.Dock="Right" ContentTemplate="{TemplateBinding ErrorTemplate}" DataContext="{TemplateBinding Owner}" Content="{Binding (DataValidationErrors.Errors)}" IsVisible="{Binding (DataValidationErrors.HasErrors)}"/>
                        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter>
            <Setter Property="ErrorTemplate">
                <DataTemplate x:DataType="collections:IEnumerable">
                    <ItemsControl ItemsSource="{Binding}" Foreground="{DynamicResource AppDangerBrush}" Margin="4,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:Object">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </Setter>
        </Style>

        <!-- CheckBox hover/focus feedback -->
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource AppHoverOverlayBrush}" />
        </Style>
        <Style Selector="CheckBox:focus /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusOuterBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="CheckBox:focus-visible /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusInnerBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- ISSUE_09: RadioButton and TabItem were the only interactive control types with no
             suite-wide Hand cursor (Button, Slider, ComboBox, CheckBox, ListBoxItem,
             ToggleButton and MenuItem all have one), and RadioButton had none of the
             hover/focus treatment its CheckBox sibling gets directly above. Template part is
             Border#RootBorder in the Fluent 11.0.10 RadioButton theme.
             NOTE: Expander needs no rule here — its header is a templated ToggleButton, which
             already inherits Cursor=Hand from the global ToggleButton style below. -->
        <Style Selector="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="{DynamicResource AppHoverOverlayBrush}" />
        </Style>
        <Style Selector="RadioButton:focus /template/ Border#RootBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusOuterBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="RadioButton:focus-visible /template/ Border#RootBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusInnerBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Canvas.TimelineSeekSurface:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha10Brush}" />
        </Style>
        <Style Selector="Canvas.TimelineSeekSurface:focus">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha15Brush}" />
        </Style>
        <Style Selector="Canvas.TimelineSeekSurface:focus-visible">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha20Brush}" />
        </Style>
        <Style Selector="Grid.TimelineSeekSurface:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha10Brush}" />
        </Style>
        <Style Selector="Grid.TimelineSeekSurface:focus">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha15Brush}" />
        </Style>
        <Style Selector="Grid.TimelineSeekSurface:focus-visible">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha20Brush}" />
        </Style>

        <!-- ListBoxItem hover/focus feedback -->
        <Style Selector="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha10Brush}" />
        </Style>
        <Style Selector="ListBoxItem:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusInnerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusInnerBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppListBoxSelectedBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppListBoxSelectedHoverBrush}" />
        </Style>

        <!-- ToggleButton styling -->
        <Style Selector="ToggleButton">
            <Setter Property="MinHeight" Value="{DynamicResource AppButtonMinHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="translateY(2px)"/>
        </Style>
        <Style Selector="ToggleButton.Primary">
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryDeepBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppPrimaryButtonGradient}"/>
        </Style>
        <Style Selector="ToggleButton.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryButtonHoverGradient}"/>
        </Style>
        <Style Selector="ToggleButton.Primary:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSuccessButtonGradient}"/>
        </Style>

        <Style Selector="ToggleButton.Primary:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSuccessButtonHoverGradient}"/>
        </Style>

        <!-- Close button style for FinishedDialog and other borderless windows -->
        <Style Selector="Button.CloseBtn">
            <Setter Property="Width" Value="{DynamicResource AppCloseBtnSize}" />
            <Setter Property="Height" Value="{DynamicResource AppCloseBtnSize}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize16}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppFocusOuterBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.CloseBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppCloseBtnHoverForegroundBrush}" />
        </Style>
        <Style Selector="Button.CloseBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCloseBtnHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.CloseBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCloseBtnPressedBackgroundBrush}" />
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- ISSUE_06 (audit round 5): VideoMergerWindow's "Remove Selected" and "Clear All" menu
             items both carry Classes="Danger", but the ONLY .Danger selectors in the suite were
             Button.Danger / ToggleButton.Danger — so the class matched nothing and the two
             destructive entries rendered identically to harmless ones. Their authors had to
             hand-write "(WARNING: Cannot be undone)" into each header to compensate. This is
             deliberately COLOUR-ONLY (no layout/padding change) so the Fluent MenuItem template
             geometry is untouched; the red Foreground is inherited by the TextBlocks in each
             custom MenuItem.Header. -->
        <Style Selector="MenuItem.Danger">
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        </Style>

        <!-- Global Wizard Indicator Styles (ISSUE_01 & ISSUE_10 resolution) -->
        <Style Selector="Border.WizDotPending">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        </Style>
        <Style Selector="Border.WizDotActive">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.WizDotDone">
            <Setter Property="Background" Value="{DynamicResource AppSuccessBrush}"/>
        </Style>
        <Style Selector="TextBlock.WizIconPending">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.WizIconOn">
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.WizLabelPending">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="TextBlock.WizLabelActive">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.WizLabelDone">
            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- High-Contrast & Assistive Mode Focus Overrides (ISSUE_10) -->
        <Style Selector="TemplatedControl:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="FlyoutPresenter.CustomFlyout">
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>


    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://KeyPulse/KeyPulse.ico" ToolTipText="KeyPulse" Clicked="OpenKeybinds_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open Keybinds" Click="OpenKeybinds_Clicked"/>
                        <NativeMenuItem Header="Settings" Click="OpenSettings_Clicked"/>
                        <NativeMenuItem Header="Exit" Click="Exit_Clicked"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>



