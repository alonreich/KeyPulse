<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyPulse"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="560"
        x:Class="KeyPulse.MainWindow"
        x:DataType="local:MainWindow"
        Icon="avares://KeyPulse/KeyPulse.ico"
        Title="KeyPulse"
        Width="860"
        Height="560"
        MinWidth="640"
        MinHeight="460">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0"
                   Text="Shortcuts"
                   Classes="SectionTitle"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                Classes="Panel"
                Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*,Auto,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Shortcut"
                           Classes="Label"
                           Margin="0,0,8,4" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="Action"
                           Classes="Label"
                           Margin="0,0,8,4" />

                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         Name="KeyCombo"
                         PlaceholderText="Press keys..."
                         HorizontalAlignment="Stretch"
                         IsReadOnly="True"
                         KeyDown="KeyCombo_KeyDown"
                         TextChanged="KeyCombo_TextChanged"
                         TabIndex="0"
                         Margin="0,0,8,0" />
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Name="ActionCombo"
                          SelectedIndex="0"
                          HorizontalAlignment="Stretch"
                          TabIndex="1"
                          Margin="0,0,8,0">
                    <ComboBoxItem>Open Folder</ComboBoxItem>
                    <ComboBoxItem>Launch Program</ComboBoxItem>
                    <ComboBoxItem>Open URL</ComboBoxItem>
                    <ComboBoxItem>Type Text (Legacy)</ComboBoxItem>
                    <ComboBoxItem>Paste Plain Text</ComboBoxItem>
                </ComboBox>
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Name="AddButton"
                        Content="Add"
                        Classes="Primary"
                        Click="Add_Click"
                        Margin="0,0,8,0"
                        TabIndex="4"
                        MinWidth="96" />
                <Button Grid.Row="1"
                        Grid.Column="3"
                        Name="CancelEditButton"
                        Content="Cancel"
                        Classes="Secondary"
                        Click="CancelEdit_Click"
                        IsVisible="False"
                        TabIndex="5"
                        MinWidth="86" />

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="4"
                            Margin="0,4,0,0">
                    <TextBlock Name="EditorModeText"
                               Classes="EditModeText"
                               IsVisible="False"
                               TextWrapping="Wrap" />
                    <TextBlock Name="ShortcutErrorText"
                               Classes="ErrorText"
                               IsVisible="False" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="4"
                           Name="TargetLabel"
                           Text="Folder path"
                           Classes="Label"
                           Margin="0,10,0,4" />

                <Grid Grid.Row="4"
                      Grid.ColumnSpan="4"
                      ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Name="TargetText"
                             PlaceholderText="Select a folder, app, URL, or text"
                             HorizontalAlignment="Stretch"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap"
                             TabIndex="2"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Name="BrowseBtn"
                            Content="Browse"
                            Classes="Secondary"
                            Click="Browse_Click"
                            TabIndex="3"
                            MinWidth="92"
                            ToolTip.Tip="Choose a file or folder" />
                </Grid>

                <TextBlock Grid.Row="5"
                           Grid.ColumnSpan="4"
                           Name="TargetErrorText"
                           Classes="ErrorText"
                           IsVisible="False"
                           Margin="0,4,0,0" />
                <TextBlock Grid.Row="6"
                           Grid.ColumnSpan="4"
                           Name="TargetHintText"
                           Classes="Muted"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Classes="Panel"
                Padding="0">
            <Grid RowDefinitions="Auto,*"
                  Margin="12,10,12,6">
                <Grid Grid.Row="0"
                      Name="ShortcutHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="{DynamicResource ShortcutKeyColumnWidth}" MinWidth="160" MaxWidth="360" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{DynamicResource ShortcutActionColumnWidth}" MinWidth="110" MaxWidth="260" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{DynamicResource ShortcutStatusColumnWidth}" MinWidth="110" MaxWidth="260" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{DynamicResource ShortcutTargetColumnWidth}" MinWidth="180" MaxWidth="1600" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Classes="ShortcutGridHeaderCell">
                        <TextBlock Text="Enabled" Classes="ListHeader" HorizontalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Classes="ShortcutGridHeaderCell">
                        <TextBlock Text="Shortcut" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="2">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutKeyColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize columns"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>
                    <Border Grid.Column="3" Classes="ShortcutGridHeaderCell">
                        <TextBlock Text="Action" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="4">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutActionColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize columns"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>
                    <Border Grid.Column="5" Classes="ShortcutGridHeaderCell">
                        <TextBlock Text="Status" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="6">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutStatusColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize columns"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>
                    <Border Grid.Column="7" Classes="ShortcutGridHeaderCell">
                        <TextBlock Text="Target" Classes="ListHeader" />
                    </Border>
                    <Grid Grid.Column="8">
                        <Border Classes="ShortcutGridSeparatorCell" />
                        <Border Classes="ShortcutGridSeparatorLine" />
                        <Border Name="ShortcutTargetColumnSplitter"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to resize target column"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>
                    <Border Grid.Column="9" Classes="ShortcutGridHeaderCell">
                        <TextBlock Text="Actions" Classes="ListHeader" />
                    </Border>
                </Grid>

                <ListBox Grid.Row="1"
                         Name="HotkeyList"
                         Classes="ShortcutList"
                         SelectionChanged="HotkeyList_SelectionChanged"
                         ItemsSource="{Binding Hotkeys}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:HotkeyEntry">
                            <Border Background="{Binding RowBackground}"
                                    CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="{DynamicResource ShortcutKeyColumnWidth}" MinWidth="160" MaxWidth="360" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{DynamicResource ShortcutActionColumnWidth}" MinWidth="110" MaxWidth="260" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{DynamicResource ShortcutStatusColumnWidth}" MinWidth="110" MaxWidth="260" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{DynamicResource ShortcutTargetColumnWidth}" MinWidth="180" MaxWidth="1600" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="ShortcutGridCell">
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Click="Enabled_Click"
                                                  TabIndex="0"
                                                  ToolTip.Tip="Enable or disable this shortcut" />
                                    </Border>
                                    <Border Grid.Column="1" Classes="ShortcutGridCell">
                                        <TextBlock Text="{Binding KeyCombination}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppAccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding KeyCombination}" />
                                    </Border>
                                    <Grid Grid.Column="2">
                                        <Border Classes="ShortcutGridSeparatorCell" />
                                        <Border Classes="ShortcutGridSeparatorLine" />
                                    </Grid>
                                    <Border Grid.Column="3" Classes="ShortcutGridCell">
                                        <TextBlock Text="{Binding ActionDisplay}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Grid Grid.Column="4">
                                        <Border Classes="ShortcutGridSeparatorCell" />
                                        <Border Classes="ShortcutGridSeparatorLine" />
                                    </Grid>
                                    <Border Grid.Column="5" Classes="ShortcutGridCell">
                                        <TextBlock Text="{Binding RegistrationStatus}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="{Binding RegistrationBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding RegistrationStatus}" />
                                    </Border>
                                    <Grid Grid.Column="6">
                                        <Border Classes="ShortcutGridSeparatorCell" />
                                        <Border Classes="ShortcutGridSeparatorLine" />
                                    </Grid>
                                    <Border Grid.Column="7" Classes="ShortcutGridCell">
                                        <Grid ColumnDefinitions="*,Auto"
                                              HorizontalAlignment="Stretch">
                                            <TextBlock Grid.Column="0"
                                                   Text="{Binding Target}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Target}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="..."
                                                       Classes="Muted"
                                                       IsVisible="{Binding HasLongTarget}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"
                                                       ToolTip.Tip="{Binding TargetOverflowHint}" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="8">
                                        <Border Classes="ShortcutGridSeparatorCell" />
                                        <Border Classes="ShortcutGridSeparatorLine" />
                                    </Grid>
                                    <Border Grid.Column="9" Classes="ShortcutGridCell">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="6">
                                            <Button Content="REMOVE"
                                                    Classes="Danger"
                                                    Click="Remove_Click"
                                                    Width="78"
                                                    MinWidth="78"
                                                    Height="24"
                                                    MinHeight="24"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="8.5"
                                                    TabIndex="1" />
                                            <Button Classes="Secondary"
                                                    Click="Duplicate_Click"
                                                    Width="78"
                                                    MinWidth="78"
                                                    Height="24"
                                                    MinHeight="24"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="8.5"
                                                    TabIndex="2"
                                                    IsVisible="{Binding IsEditing}"
                                                    ToolTip.Tip="Duplicate this shortcut">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="3">
                                                    <TextBlock Text="⧉"
                                                               FontSize="9"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="DUPLICATE"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Name="ServiceStatusText"
                       Text="KeyPulse background service running. Run as administrator to trigger shortcuts inside elevated apps."
                       ToolTip.Tip="If you wish to trigger hotkeys and type text into Administrator elevated windows, run KeyPulse as Administrator."
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0" />
            <Button Grid.Column="1"
                    Content="Settings"
                    Classes="Secondary"
                    Click="Settings_Click"
                    TabIndex="6"
                    MinWidth="98" />
        </Grid>
    </Grid>
</Window>
