<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>KeyPulse.ico</ApplicationIcon>

    <!-- ISSUE_15: every build used to report 1.0.0.0, so nobody could tell which one they had.
         build.cmd overrides this with -p:Version=yyyy.MM.dd.HHmm; the value here is only the
         fallback for a plain "dotnet build" from an editor. Keep every part <= 65534. -->
    <Version Condition="'$(Version)' == ''">2026.8.21.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>KeyPulse</Product>
    <Company>Alon</Company>
    <AssemblyTitle>KeyPulse</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="KeyPulse.ico" />
    <EmbeddedResource Include="NativeLibs\av_libglesv2.dll" />
    <EmbeddedResource Include="NativeLibs\libHarfBuzzSharp.dll" />
    <EmbeddedResource Include="NativeLibs\libSkiaSharp.dll" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Windows.Extensions" Version="10.0.11" />
    <!-- ISSUE_3: DPAPI, so targets are protected with a key tied to the Windows account instead of
         one hard-coded into the executable. NativeAOT-safe. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\click.wav" />
    <EmbeddedResource Include="Assets\close.wav" />
    <EmbeddedResource Include="Assets\error.wav" />
  </ItemGroup>
</Project>

